{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.11.0/schema.json",
  "name": "barras-cero",
  "position": {
    "x": 650,
    "y": 200,
    "z": 1,
    "height": 420,
    "width": 590,
    "tabOrder": 1
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimProduct"
                    }
                  },
                  "Property": "Brand"
                }
              },
              "queryRef": "DimProduct.Brand",
              "nativeQueryRef": "Brand",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Margen de una semana con cero"
                }
              },
              "queryRef": "_Measures.Margen de una semana con cero",
              "nativeQueryRef": "Margen de una semana con cero"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Con COALESCE(_, 0) - las mismas marcas se DIBUJAN'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
