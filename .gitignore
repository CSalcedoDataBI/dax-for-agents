# OS / editor cruft
Thumbs.db
.DS_Store
*.swp
.vscode/
.idea/

# Session / temp working files
_tmp_*
*.bak
*.tmp

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# agentic-board session state (local, not shared) — except the shared board config,
# which NORTE versions so every session uses grouped PRs (preferGroupedPRs).
.agentic-board/*
!.agentic-board/config.json

# Scratch left behind by a crashed sync. The prefix moved from .library.staging- to
# .publish-; an ignore rule guarding a path the code no longer uses guards nothing.
skills/dax-reference/.publish-*/
/HANDOFF.md
/.handoffs/

# Session scratch: one-off scripts, unoptimised captures.
/tmp/

# Agent harness notes. They record what is true of the MACHINE a session ran on —
# assembly paths, which refresh path leaves a banner — not of this repository.
# Exception: the NORTE experto agent is versioned (it is part of the tool: it reviews
# every PR against FICHA.md).
/.claude/*
!/.claude/agents/
/.claude/agents/*
!/.claude/agents/experto.md
